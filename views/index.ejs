<%- include('partials/head') %>
<section class="hero reveal">
  <h1><%= site.title %></h1>
  <% if (site.subtitle) { %><p class="sub"><%= site.subtitle %></p><% } %>
</section>
<% if (locals.tag) { %><p class="notice glass">Viewing &ldquo;<%= tag %>&rdquo; &middot; <a href="/">All posts</a></p><% } %>
<section class="cards">
<% posts.forEach(function (p) { %>
  <article class="card reveal">
    <h2><a href="/post/<%= encodeURIComponent(p.slug) %>"><%= p.title %></a></h2>
    <p class="meta">
      <time><%= p.created_at.slice(0, 10) %></time>
      <% (p.tags ? p.tags.split(',') : []).forEach(function (t) { t = t.trim(); if (!t) return; %><a class="tag" href="/?tag=<%= encodeURIComponent(t) %>"><%= t %></a><% }); %>
    </p>
    <p class="excerpt"><%= p.content.replace(/[#>*`_!\[\]()]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 90) %></p>
    <a class="more" href="/post/<%= encodeURIComponent(p.slug) %>">Read full text</a>
  </article>
<% }); %>
<% if (posts.length === 0) { %><p class="empty glass">No posts yet. Write your first one from the admin panel.</p><% } %>
</section>
<% if (Object.keys(tagCount).length) { %>
<section class="tags reveal">
  <h3>Tags</h3>
  <p><% Object.keys(tagCount).forEach(function (t) { %><a class="tag" href="/?tag=<%= encodeURIComponent(t) %>"><%= t %> (<%= tagCount[t] %>)</a><% }); %></p>
</section>
<% } %>
<%- include('partials/footer') %>
